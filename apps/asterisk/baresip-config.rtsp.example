# Apply this as data.config in baresip-configmap once image is baresip-ffmpeg:1.0
poll_method		epoll
sip_listen		0.0.0.0:5062
module_path		/usr/lib/x86_64-linux-gnu/baresip/modules
module			g711.so
module			auconv.so
module			auresamp.so
module			ausine.so
module			aufile.so
module			avcodec.so
module			avformat.so
module			swscale.so
module			account.so
module			contact.so
module			menu.so
module			uuid.so
module			stun.so
module			turn.so
module			ice.so
module			fakevideo.so
audio_player		aufile
audio_source		ausine
video_source		avformat,rtsp://10.43.38.49:8554/cam_122
video_display		fakevideo
avformat_rtsp_transport	tcp
video_size		1280x720
video_bitrate		800000
video_fps		15
sip_verify_server	no
