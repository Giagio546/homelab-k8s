# baresip with FFmpeg (avformat/avcodec/swscale) for RTSP camera into SIP.
# Build: docker build -f Dockerfile.baresip -t baresip-ffmpeg:1.0 .
# Save:  docker save baresip-ffmpeg:1.0 -o baresip-ffmpeg-1.0.tar
# On k3s: k3s ctr images import baresip-ffmpeg-1.0.tar
FROM debian:trixie AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates git cmake make clang \
    libssl-dev zlib1g-dev \
    libopus-dev libspandsp-dev \
    libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libavdevice-dev \
    pkg-config \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 https://github.com/baresip/re.git \
 && cmake -S re -B re/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
 && cmake --build re/build -j"$(nproc)" && cmake --install re/build
RUN git clone --depth 1 https://github.com/baresip/baresip.git \
 && cmake -S baresip -B baresip/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
      -DMODULES="account;auconv;aufile;auresamp;ausine;g711;uuid;menu;contact;stun;turn;ice;avcodec;avformat;swscale;fakevideo;vidbridge;srtp;dtls_srtp" \
 && cmake --build baresip/build -j"$(nproc)" && cmake --install baresip/build

FROM debian:trixie-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates openssl \
    libopus0 libspandsp2 \
    libavcodec61 libavformat61 libavutil59 libswscale8 libavdevice61 \
 || apt-get install -y --no-install-recommends \
    ca-certificates openssl libopus0 libspandsp2 \
    libavcodec-extra libavformat61 libavutil59 libswscale8 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/bin/baresip /usr/bin/baresip
COPY --from=build /usr/lib/ /usr/lib/
ENV USER=root
WORKDIR /root
ENTRYPOINT ["baresip"]